<Window x:Class="EquipmentTracking.App.Views.DiagnosticDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostic details"
        Width="780"
        Height="640"
        MinWidth="580"
        MinHeight="440"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource WarningSurfaceBrush}" VerticalAlignment="Top">
                <TextBlock Text="&#xE946;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{DynamicResource WarningBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="HeadingText"
                       Grid.Column="1"
                       Style="{StaticResource SectionTitleStyle}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Margin="42,6,0,14"
                   Style="{StaticResource SupportingTextStyle}" />

        <TextBlock Grid.Row="2"
                   Text="Technical details"
                   Style="{StaticResource FieldLabelStyle}" />

        <TextBox x:Name="DetailsText"
                 Grid.Row="3"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12" />

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Copy these details only through an approved support channel."
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy details"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CopyDetails_Click"
                        Margin="0,0,10,0" />
                <Button Content="Close"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
