<Window x:Class="EquipmentTracking.App.Views.DeviceStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{Binding Title}"
        Width="1020"
        Height="760"
        MinWidth="840"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Top">
                <TextBlock Text="&#xE9D9;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}">
                    <Run Text="Ticket " />
                    <Run Text="{Binding Transaction.TicketNumber}" FontWeight="SemiBold" />
                    <Run Text=" · " />
                    <Run Text="{Binding Transaction.CustomerName}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,16,0,14">
          <Border Style="{StaticResource InfoCalloutStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{DynamicResource InfoBrush}"
                           VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding PickupGuidance}" Style="{StaticResource SupportingTextStyle}" />
            </Grid>
          </Border>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PickupScanBox" Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="4096" PreviewKeyDown="PickupScanBox_OnPreviewKeyDown" Margin="0,0,10,0"
                     ToolTip="Scan a device, serial number, or asset tag, then press Enter."
                     automation:AutomationProperties.Name="Scan device for pickup" />
            <Button Grid.Column="1" Content="Select scan" Style="{StaticResource SecondaryButtonStyle}"
                    Click="SelectScan_OnClick" Margin="0,0,10,0" />
            <Button Grid.Column="2" Content="Select ready" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SelectReadyCommand}" Margin="0,0,10,0" />
            <Button Grid.Column="3" Content="Clear" Style="{StaticResource TertiaryButtonStyle}"
                    Command="{Binding ClearPickupSelectionCommand}" />
          </Grid>
          <TextBlock Text="{Binding ScanFeedback}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding PickupSummary}" FontWeight="SemiBold" Margin="0,8,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}"
                  SelectionMode="Single"
                  automation:AutomationProperties.Name="Devices in selected 1297">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding DeviceNumber}" IsReadOnly="True" Width="55" />
                <DataGridTemplateColumn Header="Collect" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsPickedUp, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanChange}" HorizontalAlignment="Center"
                                      automation:AutomationProperties.Name="Select this device for pickup" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" IsReadOnly="True" Width="*" MinWidth="150" />
                <DataGridTextColumn Header="Part number" Binding="{Binding PartNumber}" IsReadOnly="True" Width="120" />
                <DataGridTextColumn Header="Serial number" Binding="{Binding SerialNumber}" IsReadOnly="True" Width="*" MinWidth="150" />
                <DataGridTemplateColumn Header="Status" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Grid>
                            <TextBlock Text="{Binding DisplayStatus}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanEditStatus}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsPickupOnly, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanEditStatus}"
                                      automation:AutomationProperties.Name="Device status">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanEditStatus}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.IsPickupOnly, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                          </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Technician name and grade" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding TechnicianSuggestions}"
                          Text="{Binding Technician, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True"
                          automation:AutomationProperties.Name="Technician name and grade" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="1000"
                         automation:AutomationProperties.Name="Optional device update notes" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Review the selected devices. A pickup requires a customer-signed copy; ordinary status changes do not."
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,18,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource TertiaryButtonStyle}"
                        Click="Cancel_OnClick"
                        Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_OnClick"
                        automation:AutomationProperties.Name="Save device updates">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource ButtonIconStyle}" />
                        <TextBlock Text="{Binding SaveLabel}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
