<UserControl x:Class="EquipmentTracking.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:EquipmentTracking.App.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Operations overview" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Find active or archived 1297s, review ticket status, and see where equipment is currently distributed."
                                   Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            VerticalAlignment="Top"
                            Margin="20,0,0,0"
                            automation:AutomationProperties.Name="Refresh dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ProgressBar Height="3"
                             Margin="0,0,0,13"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource AccentFillBrush}"
                             Background="{DynamicResource SurfaceTertiaryBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Transaction view" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Column="2" Text="Search 1297 records — type anywhere on Dashboard" Style="{StaticResource FieldLabelStyle}" />

                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding TransactionScopes}"
                                  SelectedItem="{Binding SelectedTransactionScope}"
                                  automation:AutomationProperties.Name="Transaction view" />

                        <Grid Grid.Row="1" Grid.Column="2">
                            <TextBox x:Name="TransactionSearchBox"
                                     Padding="34,11,10,11"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="TransactionSearchBox_OnTextChanged"
                                     PreviewKeyDown="TransactionSearchBox_OnPreviewKeyDown"
                                     MaxLength="256"
                                     ToolTip="Type anywhere on Dashboard or scan a printed 1297 QR code to search by 1297 ID, ticket, customer, organization, model, part number, serial number, or status"
                                     automation:AutomationProperties.Name="Search 1297 records" />
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="12,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <TextBlock Text="Type anywhere or scan a 1297 code"
                                       Margin="34,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Row="1"
                                Grid.Column="4"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SearchCommand}"
                                MinWidth="102"
                                automation:AutomationProperties.Name="Search 1297 records">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource ButtonIconStyle}" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Operational metrics: the active-device state is intentionally primary. -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PrimaryMetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Active devices" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="&#xE8B7;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding ActiveDeviceCount}"
                                       Style="{StaticResource NumericKpiStyle}"
                                       Margin="0,8,0,4" />
                            <TextBlock Grid.Row="2" Text="Currently issued" Style="{StaticResource CaptionTextStyle}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Active 1297s" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding ActiveTransactionCount}"
                                       Style="{StaticResource NumericKpiStyle}"
                                       Margin="0,8,0,4" />
                            <TextBlock Text="Open hand receipts" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Picked up today" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding ReturnedTodayCount}"
                                       Style="{StaticResource NumericKpiStyle}"
                                       Margin="0,8,0,4" />
                            <TextBlock Text="Devices returned" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Archived 1297s" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding ArchivedTransactionCount}"
                                       Style="{StaticResource NumericKpiStyle}"
                                       Margin="0,8,0,4" />
                            <TextBlock Text="Completed records" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="1297 transactions" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="One row represents one ticket and its associated devices."
                                               Style="{StaticResource PageSubtitleStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource NeutralPillStyle}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Transactions.Count, StringFormat={}{0} results}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,16,0,0" MinHeight="370">
                                <DataGrid ItemsSource="{Binding Transactions}"
                                          SelectedItem="{Binding SelectedTransaction}"
                                          IsReadOnly="True"
                                          Visibility="{Binding HasTransactions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          automation:AutomationProperties.Name="1297 transaction results">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="1297 ID" Binding="{Binding TransactionId}" Width="225" />
                                        <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNumber}" Width="135" />
                                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" MinWidth="150" />
                                        <DataGridTextColumn Header="Organization" Binding="{Binding Organization}" Width="135" />
                                        <DataGridTextColumn Header="Devices" Binding="{Binding DeviceCount}" Width="72" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusSummary}" Width="155" />
                                        <DataGridTextColumn Header="Issued" Binding="{Binding IssuedAt, StringFormat={}{0:MMM d, yyyy}}" Width="112" />
                                        <DataGridTextColumn Header="Closed" Binding="{Binding ClosedAt, StringFormat={}{0:MMM d, yyyy}}" Width="112" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Style="{StaticResource EmptyStatePanelStyle}"
                                        Visibility="{Binding HasNoTransactions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="No matching 1297 records"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   Margin="0,10,0,5"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Adjust the search text or switch between Active 1297s and Archive."
                                                   Style="{StaticResource SupportingTextStyle}"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                <TextBlock Text="{Binding CloseoutAvailabilityMessage}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,10" />
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Documents" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DocumentsCommand}" Margin="0,0,10,8"
                                            ToolTip="Original intake and all pickup copies under this record"
                                            automation:AutomationProperties.Name="View documents under selected 1297" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding OpenSelectedPdfCommand}"
                                            Margin="0,0,10,8"
                                            automation:AutomationProperties.Name="Open selected PDF">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource ButtonIconStyle}" />
                                            <TextBlock Text="Open PDF" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding PrintTwoCopiesCommand}"
                                            ToolTip="{Binding PrintAvailabilityMessage}"
                                            Margin="0,0,10,8"
                                            automation:AutomationProperties.Name="Print selected 1297 as two copies on one US Letter sheet">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE749;" Style="{StaticResource ButtonIconStyle}" />
                                            <TextBlock Text="Print 1297's" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CloseoutSelectedCommand}"
                                            Margin="0,0,10,8"
                                            ToolTip="{Binding CloseoutAvailabilityMessage}"
                                            automation:AutomationProperties.Name="Close out selected 1297">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FB;" Style="{StaticResource ButtonIconStyle}" />
                                            <TextBlock Text="Close out 1297" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Partial pickup" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding PartialPickupCommand}" Margin="0,0,0,8"
                                            ToolTip="Scan or check the devices being collected, then sign a separate pickup copy"
                                            automation:AutomationProperties.Name="Partial pickup for selected 1297" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Device distribution" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Active devices only" Style="{StaticResource PageSubtitleStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock Text="Group chart by" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding ChartMetrics}"
                                          SelectedItem="{Binding SelectedChartMetric}"
                                          automation:AutomationProperties.Name="Group device chart by" />
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,18,0,0">
                                <StackPanel Visibility="{Binding HasChartData, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <controls:PieChart ItemsSource="{Binding ChartSlices}"
                                                       Height="230"
                                                       Margin="0,0,0,16"
                                                       automation:AutomationProperties.Name="Active device distribution chart"
                                                       automation:AutomationProperties.HelpText="Hover a slice to identify its category, count, and percentage. The labeled list below provides the same values without requiring a pointer." />
                                    <ItemsControl ItemsSource="{Binding ChartSlices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="12"
                                                            Height="12"
                                                            CornerRadius="2"
                                                            Background="{Binding Brush}"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayText}"
                                                               TextWrapping="Wrap"
                                                               Style="{StaticResource SupportingTextStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Style="{StaticResource EmptyStatePanelStyle}"
                                        Visibility="{Binding HasNoChartData, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No active devices"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Distribution appears after an active intake is finalized."
                                                   Style="{StaticResource SupportingTextStyle}"
                                                   TextAlignment="Center"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
