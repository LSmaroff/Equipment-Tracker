<UserControl x:Class="EquipmentTracking.App.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Recovery" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Resume or safely roll back an intake, pickup, or closeout interrupted by a crash, restart, Adobe session, or file-access failure."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Top"
                        Margin="20,0,0,0"
                        automation:AutomationProperties.Name="Refresh recovery items">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource ButtonIconStyle}" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressBar Height="3"
                         Margin="0,0,0,13"
                         IsIndeterminate="True"
                         Foreground="{DynamicResource AccentFillBrush}"
                         Background="{DynamicResource SurfaceTertiaryBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Style="{StaticResource InfoCalloutStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{DynamicResource InfoBrush}"
                               VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Recovery state" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource SupportingTextStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid MinHeight="430">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Interrupted workflows" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Select one operation before choosing Resume or Roll back."
                                           Style="{StaticResource PageSubtitleStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource NeutralPillStyle}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Items.Count, StringFormat={}{0} pending}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <DataGrid ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding SelectedItem}"
                                      IsReadOnly="True"
                                      Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      automation:AutomationProperties.Name="Interrupted workflows">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Operation" Binding="{Binding DisplayName}" Width="2*" />
                                    <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="1.6*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                    <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, StringFormat='{}{0:g}'}" Width="1.2*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Style="{StaticResource EmptyStatePanelStyle}"
                                    Visibility="{Binding HasNoItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" MaxWidth="430">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="25"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="No interrupted work"
                                               Style="{StaticResource CardTitleStyle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,10,0,5" />
                                    <TextBlock Text="Intake, pickup, and closeout workflows are currently in a clean state."
                                               Style="{StaticResource SupportingTextStyle}"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rollback is refused after a workflow has reached an unsafe committed stage."
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TertiaryButtonStyle}"
                                        Command="{Binding OpenPdfCommand}"
                                        Margin="0,0,8,0"
                                        automation:AutomationProperties.Name="Open recovery PDF">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource ButtonIconStyle}" />
                                        <TextBlock Text="Open PDF" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding RollbackCommand}"
                                        Margin="0,0,10,0"
                                        automation:AutomationProperties.Name="Roll back selected workflow">
                                    <TextBlock Text="Roll back" />
                                </Button>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ResumeCommand}"
                                        automation:AutomationProperties.Name="Resume selected workflow">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource ButtonIconStyle}" />
                                        <TextBlock Text="Resume" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Recovery details" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Stage, status, timestamp, and the most recent recorded error."
                                       Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <TextBox Grid.Row="1"
                                 Margin="0,16,0,0"
                                 Text="{Binding SelectedDetails, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalContentAlignment="Top"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 automation:AutomationProperties.Name="Selected recovery details" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
