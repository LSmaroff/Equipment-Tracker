<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Equipment Tracking Platform"
           Manufacturer="58 SOW"
           Version="$(var.ProductVersion)"
           UpgradeCode="{C6534286-9C99-45F3-A3AF-F70508F03208}"
           Language="1033"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Equipment Tracking Platform is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="EquipmentTrackingPlatform.ico"
          SourceFile="..\..\src\EquipmentTracking.App\Assets\EquipmentTrackingPlatform.ico" />
    <Property Id="ARPPRODUCTICON" Value="EquipmentTrackingPlatform.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerDirectory" Name="58 SOW">
        <Directory Id="INSTALLFOLDER" Name="Equipment Tracking Platform" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuProductFolder" Name="Equipment Tracking Platform" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="Equipment Tracking Platform" Level="1">
      <ComponentRef Id="ApplicationComponent" />
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDirectory)\**">
        <Exclude Files="$(var.PublishDirectory)\EquipmentTrackingPlatform.exe" />
        <Exclude Files="$(var.PublishDirectory)\SHA256SUMS.txt" />
      </Files>
    </ComponentGroup>

    <Component Id="ApplicationComponent"
               Directory="INSTALLFOLDER"
               Guid="{28280458-C31B-4D79-8623-06EC6C3B3D64}">
      <File Id="ApplicationExecutable"
            Source="$(var.PublishDirectory)\EquipmentTrackingPlatform.exe"
            KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcutComponent"
               Directory="ProgramMenuProductFolder"
               Guid="{9E2EC4F8-E41F-46A7-B08F-7DC284553322}">
      <Shortcut Id="StartMenuShortcut"
                Name="Equipment Tracking Platform"
                Description="Create and manage DD Form 1297 equipment records"
                Target="[INSTALLFOLDER]EquipmentTrackingPlatform.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramMenuProductFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\58SOW\EquipmentTrackingPlatform"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcutComponent"
               Directory="DesktopFolder"
               Guid="{DDE89FB5-B94C-4059-B73B-3BE4967912D4}">
      <Shortcut Id="DesktopShortcut"
                Name="Equipment Tracking Platform"
                Description="Create and manage DD Form 1297 equipment records"
                Target="[INSTALLFOLDER]EquipmentTrackingPlatform.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\58SOW\EquipmentTrackingPlatform"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
